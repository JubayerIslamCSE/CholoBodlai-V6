# EXAMPLE VALUES ONLY. NEVER COMMIT A FILLED .env FILE.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/cholobodlai?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
APP_MEDIA_BACKEND=cloudinary
APP_ADMIN_PHONE=01XXXXXXXXX
APP_ADMIN_PASSWORD=CHOOSE_YOUR_PRIVATE_ADMIN_PASSWORD_12_CHARS_MIN
APP_JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
